# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Keep false when only exercising non-database routes such as GET /.
# Set true once the PostgreSQL instance and required extensions are ready.
DB_ENABLED=false

# PostgreSQL (DATABASE_URL takes precedence when provided)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=demurrage-defender-user
DB_PASSWORD=demurrage-defender-password
DB_DATABASE=demurrage-defender
DB_APPLICATION_ROLE=demurrage_defender_app
# Runtime PostgreSQL pool per serverless function instance.
DB_POOL_MAX=2
DB_LOGGING=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication. Development mode is never accepted when NODE_ENV=production.
AUTH_MODE=development
AUTH_DEVELOPMENT_TOKEN=replace-with-a-local-development-token
AUTH_DEVELOPMENT_FIREBASE_UID=demurrage-defender-local-development-user

# Required when AUTH_MODE=firebase. On Vercel, store explicit credentials as
# encrypted environment values. FIREBASE_PRIVATE_KEY may contain escaped \n.
# Leave both explicit fields empty to use ADC (for example, a credential file
# referenced by GOOGLE_APPLICATION_CREDENTIALS) instead.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
