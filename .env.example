POSTGRES_USER=demurrage-defender-user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=demurrage-defender

# PostgreSQL role assumed by API runtime connections after migrations.
DB_APPLICATION_ROLE=demurrage_defender_app

# Frontend API base URL for Vite builds.
# Defaults to http://localhost:3000/api/v1 in local development when unset.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Use VITE_APP_ENV=staging for a staging Vite build that uses production mode.
VITE_APP_ENV=development

# Authentication. Use development only with the API's matching explicit token.
VITE_AUTH_MODE=development
VITE_DEVELOPMENT_AUTH_TOKEN=replace-with-a-local-development-token

# Required by the Firebase web client when VITE_AUTH_MODE=firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
